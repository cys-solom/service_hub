generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Category {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]
}

model Product {
  id                    String           @id @default(cuid())
  name                  String
  nameAr                String           @default("")
  slug                  String           @unique
  description           String           @default("")
  descriptionAr         String           @default("")
  features              String           @default("[]")
  featuresAr            String           @default("[]")
  basePrice             Float
  discount              Float            @default(0)
  isActive              Boolean          @default(true)
  outOfStock            Boolean          @default(false)
  isFeatured            Boolean          @default(false)
  unavailableUntil      DateTime?
  images                String           @default("[]")
  durationLabel         String           @default("")
  warrantyOptions       String           @default("[]")
  fullWarranty          Boolean          @default(false)
  categoryId            String
  category              Category         @relation(fields: [categoryId], references: [id])
  variants              ProductVariant[]
  orderCount            Int              @default(0)
  displayOrder          Int              @default(0)
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
}

model ProductVariant {
  id           String   @id @default(cuid())
  productId    String
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  title        String
  duration     String
  price        Float
  warrantyDays Int      @default(0)
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)
  outOfStock   Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Order {
  id            String   @id @default(cuid())
  orderCode     String   @unique
  customerName  String
  customerPhone String
  customerEmail String?
  items         String
  totalPrice    Float
  status        String   @default("New")
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Settings {
  id             String @id @default(cuid())
  storeName      String @default("Service Hub")
  whatsappPhone  String @default("1234567890")
  currency       String @default("EGP")
  seoTitle       String @default("Service Hub - Digital Subscriptions")
  seoDescription String @default("Premium digital subscriptions at the best prices")
  theme          String @default("dark")
  heroStat1Value String @default("500+")
  heroStat1Label String @default("Happy Customers")
  heroStat2Value String @default("6+")
  heroStat2Label String @default("Premium Services")
  heroStat3Value String @default("24h")
  heroStat3Label String @default("Fast Delivery")
  contentEn      String @default("{}")
  contentAr      String @default("{}")
}

model Admin {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String   @default("Admin")
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Coupon {
  id            String    @id @default(cuid())
  code          String    @unique
  discount      Float
  isPercent     Boolean   @default(true)
  maxUses       Int       @default(0)
  usedCount     Int       @default(0)
  minOrderValue Float     @default(0)
  expiresAt     DateTime?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}
